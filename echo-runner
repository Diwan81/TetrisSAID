#!/usr/bin/env bash
set -euo pipefail

PORT="${1:-4173}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: python3 is required to run Echo Runner." >&2
  exit 1
fi

echo "Starting Echo Runner on http://127.0.0.1:${PORT}"
echo "Press Ctrl+C to stop."

python3 -m http.server "${PORT}" --bind 127.0.0.1
